{
  "name": "djafat",
  "version": "0.28.2",
  "private": true,
  "description": "DJAFAT — plateforme de livraison multi-plateforme (Tchad). Monorepo.",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "verify": "node scripts/pipeline/verify.mjs --full",
    "verify:fast": "node scripts/pipeline/verify.mjs --fast",
    "check:arch": "node scripts/pipeline/check-arch.mjs",
    "check:specs": "node scripts/pipeline/check-specs.mjs",
    "check:hygiene": "node scripts/pipeline/check-hygiene.mjs",
    "check:audit": "node scripts/pipeline/check-audit.mjs",
    "check:pipeline": "node --test \"scripts/pipeline/test/*.test.mjs\"",
    "env:init": "node scripts/env-init.mjs",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @djafat/api db:migrate",
    "db:migrate:dev": "pnpm --filter @djafat/api db:migrate:dev",
    "db:seed": "pnpm --filter @djafat/api db:seed",
    "db:reset": "pnpm --filter @djafat/api db:reset",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.17.0",
    "husky": "9.1.7",
    "lint-staged": "15.3.0",
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "node-forge": "^1.4.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      },
      "ignoreMissing": [
        "@nestjs/common",
        "@nestjs/core"
      ]
    }
  }
}
