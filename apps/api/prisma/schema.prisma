// DJAFAT — Prisma schema (Bloc 0 subset).
//
// SOURCE OF TRUTH for the database is the hand-written SQL in
// `prisma/migrations/*` applied via `prisma migrate deploy`. This schema is the
// client-generation contract: it models the subset of tables the API code uses
// with the typed client. PostGIS columns and double-entry mechanics are handled
// by raw SQL and are intentionally not modelled here (docs/02, docs/17).

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// ─────────────────────────── platform / configuration ───────────────────────
model Currency {
  code        String  @id @db.Char(3)
  exponent    Int     @default(0) @db.SmallInt
  symbol      String
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("currencies")
}

model Country {
  id            String   @id @default(uuid()) @db.Uuid
  isoCode       String   @unique @map("iso_code") @db.Char(2)
  name          String
  currency      String   @db.Char(3)
  defaultLocale String   @default("fr") @map("default_locale")
  timezone      String
  dialCode      String   @map("dial_code")
  active        Boolean  @default(false)
  cities        City[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("countries")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  slug      String
  timezone  String
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([countryId, slug])
  @@map("cities")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  scope     String   @default("global")
  countryId String?  @map("country_id") @db.Uuid
  cityId    String?  @map("city_id") @db.Uuid
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([key, scope, countryId, cityId], name: "platform_settings_scope_uk")
  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rollout   Json?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model PaymentMethod {
  code        String  @id
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("payment_methods")
}

model PaymentProviderRow {
  code         String  @id
  methodCode   String  @map("method_code")
  displayName  String  @map("display_name")
  capabilities Json    @default("{}")
  active       Boolean @default(true)

  @@map("payment_providers")
}

model PaymentProviderConfig {
  id              String    @id @default(uuid()) @db.Uuid
  providerCode    String    @map("provider_code")
  countryId       String?   @map("country_id") @db.Uuid
  cityId          String?   @map("city_id") @db.Uuid
  restaurantId    String?   @map("restaurant_id") @db.Uuid
  deliveryZoneId  String?   @map("delivery_zone_id") @db.Uuid
  enabled         Boolean   @default(true)
  priority        Int       @default(100)
  currency        String?   @db.Char(3)
  minAmountMinor  BigInt?   @map("min_amount_minor")
  maxAmountMinor  BigInt?   @map("max_amount_minor")
  configRef       String?   @map("config_ref")
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime? @map("valid_to") @db.Timestamptz(6)

  @@map("payment_provider_configs")
}

model CommissionRule {
  id           String    @id @default(uuid()) @db.Uuid
  scope        String
  countryId    String?   @map("country_id") @db.Uuid
  cityId       String?   @map("city_id") @db.Uuid
  restaurantId String?   @map("restaurant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  rateBps      Int       @map("rate_bps")
  minFeeMinor  BigInt?   @map("min_fee_minor")
  maxFeeMinor  BigInt?   @map("max_fee_minor")
  priority     Int       @default(100)
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(6)
  active       Boolean   @default(true)

  @@map("commission_rules")
}

model TaxRule {
  id        String    @id @default(uuid()) @db.Uuid
  countryId String    @map("country_id") @db.Uuid
  cityId    String?   @map("city_id") @db.Uuid
  kind      String
  rateBps   Int       @map("rate_bps")
  appliesTo String    @map("applies_to")
  inclusive Boolean   @default(false)
  priority  Int       @default(100)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  active    Boolean   @default(true)

  @@map("tax_rules")
}

/// ─────────────────────────────────── identity ───────────────────────────────
model Role {
  code  String @id
  label String

  @@map("roles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  email           String?
  fullName        String?   @map("full_name")
  countryId       String?   @map("country_id") @db.Uuid
  locale          String    @default("fr")
  status          String    @default("active")
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  refreshHash   String    @unique @map("refresh_hash")
  parentId      String?   @map("parent_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ip            String?
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_codes")
}

model PhoneAuthLock {
  phone       String    @id
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("phone_auth_locks")
}

/// ─────────────────────────────────── system ─────────────────────────────────
model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregate     String
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregate, aggregateId])
  @@map("outbox")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRole      String?  @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  traceId        String?  @map("trace_id")
  stepUpVerified Boolean? @map("step_up_verified")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model IdempotencyKey {
  scope       String
  key         String
  fingerprint String
  status      String    @default("reserved")
  response    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("idempotency_keys")
}

/// ─────────────────────────── finance / ledger (foundation) ──────────────────
model LedgerAccount {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  type      String
  ownerType String?  @map("owner_type")
  ownerId   String?  @map("owner_id") @db.Uuid
  currency  String   @db.Char(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_accounts")
}

model LedgerEntryGroup {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String
  idempotencyKey String   @unique @map("idempotency_key")
  currency       String   @db.Char(3)
  orderId        String?  @map("order_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  memo           String?
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by")

  @@map("ledger_entry_groups")
}

model WalletBalanceRow {
  ownerType      String   @map("owner_type")
  ownerId        String   @map("owner_id") @db.Uuid
  currency       String   @db.Char(3)
  pendingMinor   BigInt   @default(0) @map("pending_minor")
  availableMinor BigInt   @default(0) @map("available_minor")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([ownerType, ownerId, currency])
  @@map("wallet_balances")
}
