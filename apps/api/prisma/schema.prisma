// DJAFAT — Prisma schema (Bloc 0 subset).
//
// SOURCE OF TRUTH for the database is the hand-written SQL in
// `prisma/migrations/*` applied via `prisma migrate deploy`. This schema is the
// client-generation contract: it models the subset of tables the API code uses
// with the typed client. PostGIS columns and double-entry mechanics are handled
// by raw SQL and are intentionally not modelled here (docs/02, docs/17).

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// ─────────────────────────── platform / configuration ───────────────────────
model Currency {
  code        String  @id @db.Char(3)
  exponent    Int     @default(0) @db.SmallInt
  symbol      String
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("currencies")
}

model Country {
  id            String   @id @default(uuid()) @db.Uuid
  isoCode       String   @unique @map("iso_code") @db.Char(2)
  name          String
  currency      String   @db.Char(3)
  defaultLocale String   @default("fr") @map("default_locale")
  timezone      String
  dialCode      String   @map("dial_code")
  active        Boolean  @default(false)
  cities        City[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("countries")
}

model City {
  id          String       @id @default(uuid()) @db.Uuid
  countryId   String       @map("country_id") @db.Uuid
  country     Country      @relation(fields: [countryId], references: [id])
  name        String
  slug        String
  timezone    String
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurants Restaurant[]

  @@unique([countryId, slug])
  @@map("cities")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  scope     String   @default("global")
  countryId String?  @map("country_id") @db.Uuid
  cityId    String?  @map("city_id") @db.Uuid
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([key, scope, countryId, cityId], name: "platform_settings_scope_uk")
  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rollout   Json?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model PaymentMethod {
  code        String  @id
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("payment_methods")
}

model PaymentProviderRow {
  code         String  @id
  methodCode   String  @map("method_code")
  displayName  String  @map("display_name")
  capabilities Json    @default("{}")
  active       Boolean @default(true)

  @@map("payment_providers")
}

model PaymentProviderConfig {
  id              String    @id @default(uuid()) @db.Uuid
  providerCode    String    @map("provider_code")
  countryId       String?   @map("country_id") @db.Uuid
  cityId          String?   @map("city_id") @db.Uuid
  restaurantId    String?   @map("restaurant_id") @db.Uuid
  deliveryZoneId  String?   @map("delivery_zone_id") @db.Uuid
  enabled         Boolean   @default(true)
  priority        Int       @default(100)
  currency        String?   @db.Char(3)
  minAmountMinor  BigInt?   @map("min_amount_minor")
  maxAmountMinor  BigInt?   @map("max_amount_minor")
  configRef       String?   @map("config_ref")
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime? @map("valid_to") @db.Timestamptz(6)

  @@map("payment_provider_configs")
}

model CommissionRule {
  id           String    @id @default(uuid()) @db.Uuid
  scope        String
  countryId    String?   @map("country_id") @db.Uuid
  cityId       String?   @map("city_id") @db.Uuid
  restaurantId String?   @map("restaurant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  rateBps      Int       @map("rate_bps")
  minFeeMinor  BigInt?   @map("min_fee_minor")
  maxFeeMinor  BigInt?   @map("max_fee_minor")
  priority     Int       @default(100)
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(6)
  active       Boolean   @default(true)

  @@map("commission_rules")
}

model TaxRule {
  id        String    @id @default(uuid()) @db.Uuid
  countryId String    @map("country_id") @db.Uuid
  cityId    String?   @map("city_id") @db.Uuid
  kind      String
  rateBps   Int       @map("rate_bps")
  appliesTo String    @map("applies_to")
  inclusive Boolean   @default(false)
  priority  Int       @default(100)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  active    Boolean   @default(true)

  @@map("tax_rules")
}

/// ─────────────────────────────────── identity ───────────────────────────────
model Role {
  code  String @id
  label String

  @@map("roles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  email           String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  fullName        String?   @map("full_name")
  countryId       String?   @map("country_id") @db.Uuid
  locale          String    @default("fr")
  /// pending | active | suspended | blocked | deleted — docs/19 §3.
  status          String    @default("active")
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshHash      String    @unique @map("refresh_hash")
  parentId         String?   @map("parent_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  /// Set when this session's family last passed MFA step-up — docs/19 §23.
  stepUpVerifiedAt DateTime? @map("step_up_verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sessions")
}

model Permission {
  code  String @id
  label String

  @@map("permissions")
}

/// One row per enrolled admin/super_admin — TOTP secret, AES-256-GCM
/// encrypted at rest (docs/19 §22). `enabled=false` until the enrollment
/// code is confirmed once (avoids locking an admin out of their own account
/// with a secret they never actually captured in their authenticator app).
model MfaTotpSecret {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabled         Boolean   @default(false)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("mfa_totp_secrets")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_codes")
}

model PhoneAuthLock {
  phone       String    @id
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("phone_auth_locks")
}

/// ─────────────────────────────────── system ─────────────────────────────────
model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregate     String
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregate, aggregateId])
  @@map("outbox")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRole      String?  @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  traceId        String?  @map("trace_id")
  stepUpVerified Boolean? @map("step_up_verified")
  /// Free-form context for events with no natural before/after entity state
  /// (e.g. AUTH_OTP_REQUESTED) — NEVER secrets (docs/19 §24, §40).
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model IdempotencyKey {
  scope       String
  key         String
  fingerprint String
  status      String    @default("reserved")
  response    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("idempotency_keys")
}

/// ─────────────────────────── finance / ledger (foundation) ──────────────────
model LedgerAccount {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  type      String
  ownerType String?  @map("owner_type")
  ownerId   String?  @map("owner_id") @db.Uuid
  currency  String   @db.Char(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_accounts")
}

model LedgerEntryGroup {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String
  idempotencyKey String   @unique @map("idempotency_key")
  currency       String   @db.Char(3)
  orderId        String?  @map("order_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  memo           String?
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by")

  @@map("ledger_entry_groups")
}

model WalletBalanceRow {
  ownerType      String   @map("owner_type")
  ownerId        String   @map("owner_id") @db.Uuid
  currency       String   @db.Char(3)
  pendingMinor   BigInt   @default(0) @map("pending_minor")
  availableMinor BigInt   @default(0) @map("available_minor")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([ownerType, ownerId, currency])
  @@map("wallet_balances")
}

/// ────────────────────── Bloc 0.5 — walking skeleton (docs/18) ───────────────
/// Mirrors the CANONICAL enums already validated in @djafat/core
/// (packages/types/src/enums.ts, packages/core order state machine, 58 tests).
enum OrderStatus {
  draft
  awaiting_payment
  placed
  confirmed
  preparing
  ready
  courier_assigned
  picked_up
  on_the_way
  delivered
  cancelled
  rejected
  expired

  @@map("order_status")
}

enum PaymentStatus {
  pending
  authorized
  succeeded
  failed
  cancelled
  expired
  refunded
  partially_refunded
  needs_review

  @@map("payment_status")
}

model Restaurant {
  id            String    @id @default(uuid()) @db.Uuid
  countryId     String    @map("country_id") @db.Uuid
  cityId        String    @map("city_id") @db.Uuid
  city          City      @relation(fields: [cityId], references: [id])
  ownerUserId   String?   @map("owner_user_id") @db.Uuid
  slug          String    @unique
  name          String
  description   String?
  phone         String?
  addressText   String?   @map("address_text")
  logoUrl       String?   @map("logo_url")
  coverUrl      String?   @map("cover_url")
  currency      String    @db.Char(3)
  /// draft | pending_review | active | paused | suspended | closed — docs/20 §6.
  status        String    @default("draft")
  /// Cache recomputed from `reviews` (Bloc 8+) — never written by the catalog module itself.
  ratingAvg     Decimal   @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount   Int       @default(0) @map("rating_count")
  prepTimeMin   Int       @default(20) @map("prep_time_min")
  minOrderMinor BigInt    @default(0) @map("min_order_minor")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  products      Product[]
  categories    MenuCategory[]
  hours         RestaurantHours[]
  closures      RestaurantClosure[]
  orders        Order[]

  // `geom geography(Point,4326)` and the generated `search_vector tsvector`
  // exist in SQL (migration 0014) but are intentionally NOT modelled here —
  // PostGIS/tsvector aren't native Prisma types; raw SQL is the source of
  // truth for both, same D-02 convention as `addresses.geom` (docs/17).

  @@map("restaurants")
}

model MenuCategory {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?
  imageUrl     String?   @map("image_url")
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  products     Product[]

  @@map("menu_categories")
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  categoryId   String?       @map("category_id") @db.Uuid
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  slug         String
  name         String
  description  String?
  imageUrl     String?       @map("image_url")
  priceMinor   BigInt        @map("price_minor")
  currency     String        @db.Char(3)
  sortOrder    Int           @default(0) @map("sort_order")
  /// In the catalogue at all — distinct from `isAvailable` (docs/20 §19).
  isActive     Boolean       @default(true) @map("is_active")
  isAvailable  Boolean       @default(true) @map("is_available")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  optionGroups ProductOptionGroup[]

  @@unique([restaurantId, slug])
  @@map("products")
}

model ProductOptionGroup {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id])
  name          String
  /// single | multiple — docs/20 §16.
  selectionType String   @default("single") @map("selection_type")
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int      @default(1) @map("max_selections")
  isRequired    Boolean  @default(false) @map("is_required")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  options       ProductOption[]

  @@map("product_option_groups")
}

model ProductOption {
  id              String              @id @default(uuid()) @db.Uuid
  optionGroupId   String              @map("option_group_id") @db.Uuid
  optionGroup     ProductOptionGroup  @relation(fields: [optionGroupId], references: [id])
  name            String
  priceDeltaMinor BigInt              @default(0) @map("price_delta_minor")
  currency        String              @db.Char(3)
  isAvailable     Boolean             @default(true) @map("is_available")
  sortOrder       Int                 @default(0) @map("sort_order")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("product_options")
}

model RestaurantHours {
  id             String     @id @default(uuid()) @db.Uuid
  restaurantId   String     @map("restaurant_id") @db.Uuid
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  /// 0=Sunday..6=Saturday — matches JS `Date#getDay()` (docs/20 §20).
  weekday        Int
  /// Minutes since local midnight — plain int, not `@db.Time` (avoids
  /// Prisma's ambiguous Date<->Time serialisation; see migration 0018).
  opensMinutes   Int        @map("opens_minutes")
  closesMinutes  Int        @map("closes_minutes")

  @@map("restaurant_hours")
}

model RestaurantClosure {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  startsAt     DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime   @map("ends_at") @db.Timestamptz(6)
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("restaurant_closures")
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  code                  String      @unique
  idempotencyKey        String      @map("idempotency_key")
  countryId             String      @map("country_id") @db.Uuid
  cityId                String      @map("city_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  restaurantId          String      @map("restaurant_id") @db.Uuid
  restaurant             Restaurant  @relation(fields: [restaurantId], references: [id])
  courierId             String?     @map("courier_id") @db.Uuid
  status                OrderStatus @default(draft)
  currency              String      @db.Char(3)
  subtotalMinor         BigInt      @default(0) @map("subtotal_minor")
  deliveryFeeMinor      BigInt      @default(0) @map("delivery_fee_minor")
  commissionBpsSnapshot Int         @default(0) @map("commission_bps_snapshot")
  commissionMinor       BigInt      @default(0) @map("commission_minor")
  courierFeeMinor       BigInt      @default(0) @map("courier_fee_minor")
  totalMinor            BigInt      @default(0) @map("total_minor")
  expiresAt             DateTime?   @map("expires_at") @db.Timestamptz(6)
  placedAt              DateTime?   @map("placed_at") @db.Timestamptz(6)
  deliveredAt           DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledReason       String?     @map("cancelled_reason")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  items    OrderItem[]
  payments Payment[]
  delivery Delivery?
  history  OrderStatusHistory[]

  @@unique([customerId, idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String? @map("product_id") @db.Uuid
  nameSnapshot   String  @map("name_snapshot")
  unitPriceMinor BigInt  @map("unit_price_minor")
  quantity       Int
  lineTotalMinor BigInt  @map("line_total_minor")
  currency       String  @db.Char(3)

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorRole  String?      @map("actor_role")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("order_status_history")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id])
  providerCode   String        @map("provider_code")
  methodCode     String        @map("method_code")
  status         PaymentStatus @default(pending)
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  pspFeeMinor    BigInt        @default(0) @map("psp_fee_minor")
  providerRef    String?       @map("provider_ref")
  idempotencyKey String        @map("idempotency_key")
  attemptNo      Int           @default(1) @map("attempt_no")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, idempotencyKey])
  @@map("payments")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  providerCode   String    @map("provider_code")
  eventId        String    @map("event_id")
  providerRef    String?   @map("provider_ref")
  payloadHash    String    @map("payload_hash")
  signatureValid Boolean   @default(false) @map("signature_valid")
  status         String    @default("received")
  error          String?
  attempts       Int       @default(0)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([providerCode, eventId])
  @@map("webhook_events")
}

model Delivery {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @unique @map("order_id") @db.Uuid
  order           Order     @relation(fields: [orderId], references: [id])
  courierId       String    @map("courier_id") @db.Uuid
  status          String    @default("created")
  currency        String    @db.Char(3)
  courierFeeMinor BigInt    @default(0) @map("courier_fee_minor")
  assignedAt      DateTime? @map("assigned_at") @db.Timestamptz(6)
  pickedUpAt      DateTime? @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("deliveries")
}
