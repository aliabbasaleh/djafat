// DJAFAT — Prisma schema (Bloc 0 subset).
//
// SOURCE OF TRUTH for the database is the hand-written SQL in
// `prisma/migrations/*` applied via `prisma migrate deploy`. This schema is the
// client-generation contract: it models the subset of tables the API code uses
// with the typed client. PostGIS columns and double-entry mechanics are handled
// by raw SQL and are intentionally not modelled here (docs/02, docs/17).

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// ─────────────────────────── platform / configuration ───────────────────────
model Currency {
  code        String  @id @db.Char(3)
  exponent    Int     @default(0) @db.SmallInt
  symbol      String
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("currencies")
}

model Country {
  id            String   @id @default(uuid()) @db.Uuid
  isoCode       String   @unique @map("iso_code") @db.Char(2)
  name          String
  currency      String   @db.Char(3)
  defaultLocale String   @default("fr") @map("default_locale")
  timezone      String
  dialCode      String   @map("dial_code")
  active        Boolean  @default(false)
  cities        City[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("countries")
}

model City {
  id          String       @id @default(uuid()) @db.Uuid
  countryId   String       @map("country_id") @db.Uuid
  country     Country      @relation(fields: [countryId], references: [id])
  name        String
  slug        String
  timezone    String
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurants Restaurant[]

  @@unique([countryId, slug])
  @@map("cities")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  scope     String   @default("global")
  countryId String?  @map("country_id") @db.Uuid
  cityId    String?  @map("city_id") @db.Uuid
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([key, scope, countryId, cityId], name: "platform_settings_scope_uk")
  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rollout   Json?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model PaymentMethod {
  code        String  @id
  displayName String  @map("display_name")
  active      Boolean @default(true)

  @@map("payment_methods")
}

model PaymentProviderRow {
  code         String  @id
  methodCode   String  @map("method_code")
  displayName  String  @map("display_name")
  capabilities Json    @default("{}")
  active       Boolean @default(true)

  @@map("payment_providers")
}

model PaymentProviderConfig {
  id             String    @id @default(uuid()) @db.Uuid
  providerCode   String    @map("provider_code")
  countryId      String?   @map("country_id") @db.Uuid
  cityId         String?   @map("city_id") @db.Uuid
  restaurantId   String?   @map("restaurant_id") @db.Uuid
  deliveryZoneId String?   @map("delivery_zone_id") @db.Uuid
  enabled        Boolean   @default(true)
  priority       Int       @default(100)
  currency       String?   @db.Char(3)
  minAmountMinor BigInt?   @map("min_amount_minor")
  maxAmountMinor BigInt?   @map("max_amount_minor")
  /// PSP fee rate override at this scope (Bloc 5 — replaces the Bloc 0.5 hardcoded MOCK_PSP_FEE_BPS).
  feeBps         Int?      @map("fee_bps")
  configRef      String?   @map("config_ref")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)

  @@map("payment_provider_configs")
}

model CommissionRule {
  id           String    @id @default(uuid()) @db.Uuid
  scope        String
  countryId    String?   @map("country_id") @db.Uuid
  cityId       String?   @map("city_id") @db.Uuid
  restaurantId String?   @map("restaurant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  rateBps      Int       @map("rate_bps")
  minFeeMinor  BigInt?   @map("min_fee_minor")
  maxFeeMinor  BigInt?   @map("max_fee_minor")
  priority     Int       @default(100)
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(6)
  active       Boolean   @default(true)

  @@map("commission_rules")
}

model TaxRule {
  id        String    @id @default(uuid()) @db.Uuid
  countryId String    @map("country_id") @db.Uuid
  cityId    String?   @map("city_id") @db.Uuid
  kind      String
  rateBps   Int       @map("rate_bps")
  appliesTo String    @map("applies_to")
  inclusive Boolean   @default(false)
  priority  Int       @default(100)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  active    Boolean   @default(true)

  @@map("tax_rules")
}

/// ─────────────────────────────────── identity ───────────────────────────────
model Role {
  code  String @id
  label String

  @@map("roles")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  email             String?
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  fullName          String?   @map("full_name")
  /// FEAT-020: scrypt hash (`scrypt$N$r$p$salt$hash`), never the password; null = no password.
  passwordHash      String?   @map("password_hash")
  passwordUpdatedAt DateTime? @map("password_updated_at") @db.Timestamptz(6)
  countryId         String?   @map("country_id") @db.Uuid
  locale            String    @default("fr")
  /// pending | active | suspended | blocked | deleted — docs/19 §3.
  status            String    @default("active")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

/// A customer's saved address (migration 0003 — pre-existing table, modelled
/// here for the first time in Bloc 6). `geom geography(Point,4326)` exists in
/// SQL but is intentionally NOT modelled — same PostGIS convention as
/// `Restaurant.geom` below.
model Address {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  label            String?
  recipientPhone   String?   @map("recipient_phone")
  cityId           String?   @map("city_id") @db.Uuid
  quartier         String?
  street           String?
  landmark         String?
  instructions     String?
  geocodeStatus    String    @default("pending") @map("geocode_status")
  isDefault        Boolean   @default(false) @map("is_default")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// FEAT-018 — landmark-relative address, door hint, learned point (geography columns via raw SQL).
  landmarkId       String?   @map("landmark_id") @db.Uuid
  landmarkRelation String?   @map("landmark_relation")
  doorHint         String?   @map("door_hint")
  gpsAccuracyM     Int?      @map("gps_accuracy_m")
  geomSource       String    @default("user") @map("geom_source")
  verifiedCount    Int       @default(0) @map("verified_count")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)

  @@map("addresses")
}

/// FEAT-018 — shared landmarks of a city (`geom` via raw SQL).
model Landmark {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  name      String
  kind      String   @default("other")
  aliases   String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cityId, name])
  @@map("landmarks")
}

/// FEAT-018 — ≤ 10 s voice note for the courier, one per address.
model AddressVoiceNote {
  addressId  String   @id @map("address_id") @db.Uuid
  mime       String
  data       Bytes
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("address_voice_notes")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshHash      String    @unique @map("refresh_hash")
  parentId         String?   @map("parent_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  /// Set when this session's family last passed MFA step-up — docs/19 §23.
  stepUpVerifiedAt DateTime? @map("step_up_verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sessions")
}

model Permission {
  code  String @id
  label String

  @@map("permissions")
}

/// One row per enrolled admin/super_admin — TOTP secret, AES-256-GCM
/// encrypted at rest (docs/19 §22). `enabled=false` until the enrollment
/// code is confirmed once (avoids locking an admin out of their own account
/// with a secret they never actually captured in their authenticator app).
model MfaTotpSecret {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabled         Boolean   @default(false)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("mfa_totp_secrets")
}

/// FEAT-007/FEAT-008 (migrations 0030, 0031): `target` is an E.164 phone
/// (channel sms or whatsapp) or a lower-cased email (channel email) — one
/// store, one security logic.
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  target     String
  channel    String    @default("sms")
  codeHash   String    @map("code_hash")
  purpose    String
  /// FEAT-020: the request this code is bound to (registration, password login, account); null = unbound.
  context    String?
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_codes")
}

/// FEAT-020: a registration waiting for its email code, or a password login waiting for a new device's code.
model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  /// registration | password_login
  kind       String
  userId     String?   @map("user_id") @db.Uuid
  email      String
  /// registration: { fullName, phone, passwordHash } — a hash, never a password.
  payload    Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@map("auth_challenges")
}

/// FEAT-023 (migration 0042): a code the customer SENDS to DJAFAT on WhatsApp. Only
/// HMACs of the code and of the screen's token are stored; a partial unique index
/// (SQL only) keeps two waiting codes apart.
model WhatsappCode {
  id            String    @id @default(uuid()) @db.Uuid
  /// login | login_device | verify_phone
  purpose       String
  codeHash      String    @map("code_hash")
  tokenHash     String    @unique @map("token_hash")
  userId        String?   @map("user_id") @db.Uuid
  challengeId   String?   @map("challenge_id") @db.Uuid
  senderPhone   String?   @map("sender_phone")
  /// matched | not_confirmed | wrong_number — set when the message arrives
  outcome       String?
  matchedUserId String?   @map("matched_user_id") @db.Uuid
  receivedAt    DateTime? @map("received_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "whatsapp_codes_expires_idx")
  @@map("whatsapp_codes")
}

/// FEAT-020: a device that passed the email code; only an HMAC of its token is stored.
model TrustedDevice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  label         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")

  @@map("trusted_devices")
}

/// Durable brute-force lock per OTP target (phone or email) — migration 0030.
model AuthTargetLock {
  target      String    @id
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("auth_target_locks")
}

/// ─────────────────────────────────── system ─────────────────────────────────
model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregate     String
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregate, aggregateId])
  @@map("outbox")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRole      String?  @map("actor_role")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  traceId        String?  @map("trace_id")
  stepUpVerified Boolean? @map("step_up_verified")
  /// Free-form context for events with no natural before/after entity state
  /// (e.g. AUTH_OTP_REQUESTED) — NEVER secrets (docs/19 §24, §40).
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model IdempotencyKey {
  scope       String
  key         String
  fingerprint String
  status      String    @default("reserved")
  response    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("idempotency_keys")
}

/// ─────────────────────────── finance / ledger (foundation) ──────────────────
model LedgerAccount {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  type      String
  ownerType String?  @map("owner_type")
  ownerId   String?  @map("owner_id") @db.Uuid
  currency  String   @db.Char(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_accounts")
}

model LedgerEntryGroup {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String
  idempotencyKey String   @unique @map("idempotency_key")
  currency       String   @db.Char(3)
  orderId        String?  @map("order_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  memo           String?
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by")

  @@map("ledger_entry_groups")
}

model WalletBalanceRow {
  ownerType      String   @map("owner_type")
  ownerId        String   @map("owner_id") @db.Uuid
  currency       String   @db.Char(3)
  pendingMinor   BigInt   @default(0) @map("pending_minor")
  availableMinor BigInt   @default(0) @map("available_minor")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([ownerType, ownerId, currency])
  @@map("wallet_balances")
}

/// ────────────────────── Bloc 0.5 — walking skeleton (docs/18) ───────────────
/// Mirrors the CANONICAL enums already validated in @djafat/core
/// (packages/types/src/enums.ts, packages/core order state machine, 58 tests).
enum OrderStatus {
  draft
  awaiting_payment
  placed
  confirmed
  preparing
  ready
  courier_assigned
  picked_up
  on_the_way
  delivered
  cancelled
  rejected
  expired

  @@map("order_status")
}

enum PaymentStatus {
  pending
  authorized
  succeeded
  failed
  cancelled
  expired
  refunded
  partially_refunded
  needs_review

  @@map("payment_status")
}

model Restaurant {
  id                 String              @id @default(uuid()) @db.Uuid
  countryId          String              @map("country_id") @db.Uuid
  cityId             String              @map("city_id") @db.Uuid
  city               City                @relation(fields: [cityId], references: [id])
  ownerUserId        String?             @map("owner_user_id") @db.Uuid
  slug               String              @unique
  name               String
  description        String?
  phone              String?
  addressText        String?             @map("address_text")
  logoUrl            String?             @map("logo_url")
  coverUrl           String?             @map("cover_url")
  currency           String              @db.Char(3)
  /// draft | pending_review | active | paused | suspended | closed — docs/20 §6.
  status             String              @default("draft")
  /// Cache recomputed from `reviews` (Bloc 8+) — never written by the catalog module itself.
  ratingAvg          Decimal             @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount        Int                 @default(0) @map("rating_count")
  prepTimeMin        Int                 @default(20) @map("prep_time_min")
  minOrderMinor      BigInt              @default(0) @map("min_order_minor")
  /// FEAT-022 (SPEC-022-03, SPEC-022-05): neighbourhood from the list or typed under « Autre »; landmark.
  neighbourhoodId    String?             @map("neighbourhood_id") @db.Uuid
  neighbourhoodOther String?             @map("neighbourhood_other")
  landmark           String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  products           Product[]
  categories         MenuCategory[]
  hours              RestaurantHours[]
  closures           RestaurantClosure[]
  orders             Order[]

  // `geom geography(Point,4326)` and the generated `search_vector tsvector`
  // exist in SQL (migration 0014) but are intentionally NOT modelled here —
  // PostGIS/tsvector aren't native Prisma types; raw SQL is the source of
  // truth for both, same D-02 convention as `addresses.geom` (docs/17).

  @@map("restaurants")
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?
  imageUrl     String?    @map("image_url")
  sortOrder    Int        @default(0) @map("sort_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  products     Product[]

  @@map("menu_categories")
}

model Product {
  id           String               @id @default(uuid()) @db.Uuid
  restaurantId String               @map("restaurant_id") @db.Uuid
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  categoryId   String?              @map("category_id") @db.Uuid
  category     MenuCategory?        @relation(fields: [categoryId], references: [id])
  slug         String
  name         String
  description  String?
  imageUrl     String?              @map("image_url")
  priceMinor   BigInt               @map("price_minor")
  currency     String               @db.Char(3)
  sortOrder    Int                  @default(0) @map("sort_order")
  /// In the catalogue at all — distinct from `isAvailable` (docs/20 §19).
  isActive     Boolean              @default(true) @map("is_active")
  isAvailable  Boolean              @default(true) @map("is_available")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  optionGroups ProductOptionGroup[]

  @@unique([restaurantId, slug])
  @@map("products")
}

model ProductOptionGroup {
  id            String          @id @default(uuid()) @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  product       Product         @relation(fields: [productId], references: [id])
  name          String
  /// single | multiple — docs/20 §16.
  selectionType String          @default("single") @map("selection_type")
  minSelections Int             @default(0) @map("min_selections")
  maxSelections Int             @default(1) @map("max_selections")
  isRequired    Boolean         @default(false) @map("is_required")
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  options       ProductOption[]

  @@map("product_option_groups")
}

model ProductOption {
  id              String             @id @default(uuid()) @db.Uuid
  optionGroupId   String             @map("option_group_id") @db.Uuid
  optionGroup     ProductOptionGroup @relation(fields: [optionGroupId], references: [id])
  name            String
  priceDeltaMinor BigInt             @default(0) @map("price_delta_minor")
  currency        String             @db.Char(3)
  isAvailable     Boolean            @default(true) @map("is_available")
  sortOrder       Int                @default(0) @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("product_options")
}

model RestaurantHours {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  /// 0=Sunday..6=Saturday — matches JS `Date#getDay()` (docs/20 §20).
  weekday       Int
  /// Minutes since local midnight — plain int, not `@db.Time` (avoids
  /// Prisma's ambiguous Date<->Time serialisation; see migration 0018).
  opensMinutes  Int        @map("opens_minutes")
  closesMinutes Int        @map("closes_minutes")

  @@map("restaurant_hours")
}

model RestaurantClosure {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  startsAt     DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime   @map("ends_at") @db.Timestamptz(6)
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("restaurant_closures")
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  code                  String      @unique
  idempotencyKey        String      @map("idempotency_key")
  countryId             String      @map("country_id") @db.Uuid
  cityId                String      @map("city_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  restaurantId          String      @map("restaurant_id") @db.Uuid
  restaurant            Restaurant  @relation(fields: [restaurantId], references: [id])
  status                OrderStatus @default(draft)
  currency              String      @db.Char(3)
  subtotalMinor         BigInt      @default(0) @map("subtotal_minor")
  deliveryFeeMinor      BigInt      @default(0) @map("delivery_fee_minor")
  commissionBpsSnapshot Int         @default(0) @map("commission_bps_snapshot")
  commissionMinor       BigInt      @default(0) @map("commission_minor")
  courierFeeMinor       BigInt      @default(0) @map("courier_fee_minor")
  totalMinor            BigInt      @default(0) @map("total_minor")
  expiresAt             DateTime?   @map("expires_at") @db.Timestamptz(6)
  placedAt              DateTime?   @map("placed_at") @db.Timestamptz(6)
  deliveredAt           DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledReason       String?     @map("cancelled_reason")
  /// Dropoff snapshot (Bloc 6, docs/25 §8) — frozen at order creation from the
  /// customer's address book; NEVER re-read live (a later address edit must
  /// not alter a historical or in-flight order). `dropoffGeom
  /// geography(Point,4326)` exists in SQL, not modelled (PostGIS convention).
  dropoffAddressId      String?     @map("dropoff_address_id") @db.Uuid
  dropoffLabel          String?     @map("dropoff_label")
  dropoffCity           String?     @map("dropoff_city")
  dropoffQuartier       String?     @map("dropoff_quartier")
  dropoffStreet         String?     @map("dropoff_street")
  dropoffLandmark       String?     @map("dropoff_landmark")
  dropoffInstructions   String?     @map("dropoff_instructions")
  dropoffRecipientPhone String?     @map("dropoff_recipient_phone")
  dropoffGeocodeStatus  String      @default("pending") @map("dropoff_geocode_status")
  /// FEAT-018 — door hint frozen at order time ("portail bleu").
  dropoffDoorHint       String?     @map("dropoff_door_hint")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  items    OrderItem[]
  payments Payment[]
  delivery Delivery?
  history  OrderStatusHistory[]

  @@unique([customerId, idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  order          Order             @relation(fields: [orderId], references: [id])
  productId      String?           @map("product_id") @db.Uuid
  nameSnapshot   String            @map("name_snapshot")
  unitPriceMinor BigInt            @map("unit_price_minor")
  quantity       Int
  lineTotalMinor BigInt            @map("line_total_minor")
  currency       String            @db.Char(3)
  options        OrderItemOption[]

  @@map("order_items")
}

/// Immutable per-order-item option snapshot (docs/22 §9) — never re-reads
/// the catalog for a historical order's price.
model OrderItemOption {
  id              String    @id @default(uuid()) @db.Uuid
  orderItemId     String    @map("order_item_id") @db.Uuid
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  optionId        String?   @map("option_id") @db.Uuid
  nameSnapshot    String    @map("name_snapshot")
  priceDeltaMinor BigInt    @default(0) @map("price_delta_minor")
  currency        String    @db.Char(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("order_item_options")
}

/// Bloc 4 — Cart + Core Order (docs/22 §3). NEVER the pricing authority:
/// `currency` and `restaurantId` are set once, from the first item added;
/// every quote/order-creation re-reads live product/option prices instead
/// of trusting `CartItem.unitPriceMinor` (a display-only snapshot).
model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  /// Both null (no restaurant chosen yet) or both set — never just one
  /// (DB CHECK `carts_restaurant_currency_together`, docs/22 §2.1).
  restaurantId String?    @map("restaurant_id") @db.Uuid
  currency     String?    @db.Char(3)
  /// open | converted — docs/22 §3.
  status       String     @default("open")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id             String           @id @default(uuid()) @db.Uuid
  cartId         String           @map("cart_id") @db.Uuid
  cart           Cart             @relation(fields: [cartId], references: [id])
  productId      String           @map("product_id") @db.Uuid
  /// Display-only snapshot — see the model-level doc comment on `Cart`.
  nameSnapshot   String           @map("name_snapshot")
  quantity       Int
  unitPriceMinor BigInt           @map("unit_price_minor")
  currency       String           @db.Char(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  options        CartItemOption[]

  @@map("cart_items")
}

model CartItemOption {
  id              String   @id @default(uuid()) @db.Uuid
  cartItemId      String   @map("cart_item_id") @db.Uuid
  cartItem        CartItem @relation(fields: [cartItemId], references: [id])
  optionGroupId   String   @map("option_group_id") @db.Uuid
  optionId        String   @map("option_id") @db.Uuid
  nameSnapshot    String   @map("name_snapshot")
  priceDeltaMinor BigInt   @default(0) @map("price_delta_minor")
  currency        String   @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cartItemId, optionId])
  @@map("cart_item_options")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorRole  String?      @map("actor_role")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("order_status_history")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id])
  providerCode   String        @map("provider_code")
  methodCode     String        @map("method_code")
  status         PaymentStatus @default(pending)
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  pspFeeMinor    BigInt        @default(0) @map("psp_fee_minor")
  providerRef    String?       @map("provider_ref")
  idempotencyKey String        @map("idempotency_key")
  attemptNo      Int           @default(1) @map("attempt_no")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, idempotencyKey])
  @@map("payments")
}

/// FEAT-009 (migration 0032): transfers received on DJAFAT's merchant phone,
/// matched to a pending wallet payment. Unique (provider, transaction number)
/// and unique payment_id are the double-spend guarantees.
model MobileMoneyReceipt {
  id             String    @id @default(uuid()) @db.Uuid
  providerCode   String    @map("provider_code")
  transactionRef String    @map("transaction_ref")
  amountMinor    BigInt    @map("amount_minor")
  currency       String    @db.Char(3)
  senderPhone    String    @map("sender_phone")
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  source         String    @default("manual")
  status         String    @default("unmatched")
  paymentId      String?   @unique @map("payment_id") @db.Uuid
  /// FEAT-010: set when the transfer is a courier's cash remittance.
  courierId      String?   @map("courier_id") @db.Uuid
  matchedAt      DateTime? @map("matched_at") @db.Timestamptz(6)
  recordedBy     String?   @map("recorded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([providerCode, transactionRef], map: "mobile_money_receipts_ref_uk")
  @@index([providerCode, status, receivedAt(sort: Desc)], map: "mobile_money_receipts_lookup_idx")
  @@map("mobile_money_receipts")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  providerCode   String    @map("provider_code")
  eventId        String    @map("event_id")
  providerRef    String?   @map("provider_ref")
  payloadHash    String    @map("payload_hash")
  signatureValid Boolean   @default(false) @map("signature_valid")
  status         String    @default("received")
  error          String?
  attempts       Int       @default(0)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([providerCode, eventId])
  @@map("webhook_events")
}

/// Bloc 6 — real dispatch (docs/25). `pickupGeom`/`dropoffGeom`
/// `geography(Point,4326)` exist in SQL, not modelled (PostGIS convention,
/// same as `Restaurant.geom`).
model Delivery {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String    @unique @map("order_id") @db.Uuid
  order              Order     @relation(fields: [orderId], references: [id])
  /// Null until a courier is assigned — never resolved at order creation
  /// (the Bloc 0.5 hack this bloc removes; docs/25 §2).
  courierId          String?   @map("courier_id") @db.Uuid
  status             String    @default("pending")
  currency           String    @db.Char(3)
  courierFeeMinor    BigInt    @default(0) @map("courier_fee_minor")
  estimatedDistanceM Decimal?  @map("estimated_distance_m")
  actualDistanceM    Decimal?  @map("actual_distance_m")
  dispatchRadiusM    Int?      @map("dispatch_radius_m")
  dispatchAttempts   Int       @default(0) @map("dispatch_attempts")
  searchingSince     DateTime? @map("searching_since") @db.Timestamptz(6)
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz(6)
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  pickupArrivedAt    DateTime? @map("pickup_arrived_at") @db.Timestamptz(6)
  pickedUpAt         DateTime? @map("picked_up_at") @db.Timestamptz(6)
  onTheWayAt         DateTime? @map("on_the_way_at") @db.Timestamptz(6)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledReason    String?   @map("cancelled_reason")
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  failedAt           DateTime? @map("failed_at") @db.Timestamptz(6)
  failedReason       String?   @map("failed_reason")
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("deliveries")
}

/// Courier availability + last-known position (docs/25 §4). `lastGeom
/// geography(Point,4326)` exists in SQL, not modelled (PostGIS convention).
/// 1:1 with `users` (role='courier') — never courier-specific columns on
/// `User` itself, which also serves customer/staff/admin.
model Courier {
  userId           String    @id @map("user_id") @db.Uuid
  status           String    @default("offline")
  activeDeliveryId String?   @map("active_delivery_id") @db.Uuid
  lastAccuracyM    Decimal?  @map("last_accuracy_m")
  lastHeading      Decimal?  @map("last_heading")
  lastSpeedMps     Decimal?  @map("last_speed_mps")
  lastLocationAt   DateTime? @map("last_location_at") @db.Timestamptz(6)
  /// moto | velo | voiture | a_pied (FEAT-022, CHECK in migration 0041); null before FEAT-022.
  vehicleType      String?   @map("vehicle_type")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// FEAT-010: courier holds cash at or above the ceiling; dispatch skips them.
  cashBlockedAt DateTime? @map("cash_blocked_at") @db.Timestamptz(6)

  /// FEAT-022 (SPEC-022-02): the neighbourhood from the list, or the name typed under « Autre ».
  neighbourhoodId    String?   @map("neighbourhood_id") @db.Uuid
  neighbourhoodOther String?   @map("neighbourhood_other")
  birthDate          DateTime? @map("birth_date") @db.Date

  @@map("couriers")
}

/// FEAT-022 (SPEC-022-09): N'Djamena's neighbourhoods, edited by DJAFAT.
model Neighbourhood {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  /// Stable key of a reference-data row (R1); null = added by an admin.
  code      String?
  name      String
  /// Lower-case, accents removed: unique among a city's active neighbourhoods (partial index, SQL).
  nameKey   String   @map("name_key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("neighbourhoods")
}

/// FEAT-022 (SPEC-022-02, SPEC-022-06): a courier's application. Photo keys are private storage keys.
model CourierApplication {
  courierUserId               String    @id @map("courier_user_id") @db.Uuid
  /// to_complete | pending_review | approved | rejected
  status                      String    @default("to_complete")
  termsAcceptedAt             DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  /// airtel | moov
  mobileMoneyProvider         String?   @map("mobile_money_provider")
  mobileMoneyNumber           String?   @map("mobile_money_number")
  emergencyContactName        String?   @map("emergency_contact_name")
  emergencyContactPhone       String?   @map("emergency_contact_phone")
  facePhotoKey                String?   @map("face_photo_key")
  idCardPhotoKey              String?   @map("id_card_photo_key")
  drivingLicencePhotoKey      String?   @map("driving_licence_photo_key")
  vehicleRegistrationPhotoKey String?   @map("vehicle_registration_photo_key")
  insurancePhotoKey           String?   @map("insurance_photo_key")
  platePhotoKey               String?   @map("plate_photo_key")
  rejectionReason             String?   @map("rejection_reason")
  submittedAt                 DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedAt                   DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy                   String?   @map("decided_by") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("courier_applications")
}

/// FEAT-022 (SPEC-022-03, SPEC-022-05): a restaurant's application (RCCM or NIF, owner's ID, payout number).
model RestaurantApplication {
  restaurantId        String    @id @map("restaurant_id") @db.Uuid
  /// to_complete | pending_review | approved | rejected
  status              String    @default("to_complete")
  termsAcceptedAt     DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  registryNumber      String?   @map("registry_number")
  registryPhotoKey    String?   @map("registry_photo_key")
  ownerIdPhotoKey     String?   @map("owner_id_photo_key")
  /// airtel | moov
  mobileMoneyProvider String?   @map("mobile_money_provider")
  mobileMoneyNumber   String?   @map("mobile_money_number")
  rejectionReason     String?   @map("rejection_reason")
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy           String?   @map("decided_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("restaurant_applications")
}

/// FEAT-022 (SPEC-022-07 R6): a payout number or a paper changed after the approval, waiting for an admin.
model ApplicationChange {
  id              String    @id @default(uuid()) @db.Uuid
  /// courier | restaurant
  subjectType     String    @map("subject_type")
  subjectId       String    @map("subject_id") @db.Uuid
  /// mobile_money | document
  kind            String
  newValue        Json      @map("new_value")
  /// pending | approved | rejected
  status          String    @default("pending")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy       String?   @map("decided_by") @db.Uuid

  @@map("application_changes")
}

/// A dispatch proposal sent to one courier (docs/25 §5) — distinct lifecycle
/// from the delivery's own. Never durably assumed accepted: the delivery
/// only moves to `courier_accepted` once the courier actually responds.
model DeliveryOffer {
  id          String    @id @default(uuid()) @db.Uuid
  deliveryId  String    @map("delivery_id") @db.Uuid
  courierId   String    @map("courier_id") @db.Uuid
  status      String    @default("offered")
  offeredAt   DateTime  @default(now()) @map("offered_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  @@map("delivery_offers")
}

/// Extensible proof-of-delivery record (docs/25 §19). MVP = a hashed delivery
/// code (never the raw code — same discipline as OTP, docs/19).
/// Single-use (`consumedAt`), expiring (`expiresAt`), rate-limited
/// (`failedAttempts`) since Bloc 6.1 — migration 0024, docs/25 §B6.1-7.
model DeliveryProof {
  id             String    @id @default(uuid()) @db.Uuid
  deliveryId     String    @map("delivery_id") @db.Uuid
  type           String
  valueHash      String    @map("value_hash")
  reference      String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")

  @@map("delivery_proofs")
}

/// FEAT-012: a delivery code chosen when an operator takes an order on the
/// phone (the customer has no app to read it). Copied into `delivery_proofs`
/// at pickup instead of a random one. Hashed + encrypted, never raw.
model DeliveryCodePreset {
  orderId   String   @id @map("order_id") @db.Uuid
  valueHash String   @map("value_hash")
  reference String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("delivery_code_presets")
}

/// ────────────────────── Bloc 5 — payment core (docs/24) ──────────────────────
model Refund {
  id                 String   @id @default(uuid()) @db.Uuid
  paymentId          String   @map("payment_id") @db.Uuid
  amountMinor        BigInt   @map("amount_minor")
  currency           String   @db.Char(3)
  reason             String
  status             String   @default("pending")
  providerRef        String?  @map("provider_ref")
  idempotencyKey     String   @map("idempotency_key")
  entryGroup         String?  @map("entry_group") @db.Uuid
  requestedBy        String?  @map("requested_by") @db.Uuid
  /// PAY-04: the order accrual was reversed into REFUNDS_PAYABLE; the refund pays that debt off.
  compensatesAccrual Boolean  @default(false) @map("compensates_accrual")
  attempts           Int      @default(0)
  lastError          String?  @map("last_error")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([paymentId, idempotencyKey])
  @@map("refunds")
}

model Settlement {
  id                  String    @id @default(uuid()) @db.Uuid
  providerCode        String    @map("provider_code")
  periodStart         DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime  @map("period_end") @db.Timestamptz(6)
  currency            String    @db.Char(3)
  grossMinor          BigInt    @map("gross_minor")
  feesMinor           BigInt    @default(0) @map("fees_minor")
  netMinor            BigInt    @map("net_minor")
  expectedNetMinor    BigInt?   @map("expected_net_minor")
  status              String    @default("pending")
  providerReference   String?   @map("provider_reference")
  idempotencyKey      String    @unique @map("idempotency_key")
  entryGroup          String?   @map("entry_group") @db.Uuid
  reconciliationNotes String?   @map("reconciliation_notes")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reconciledAt        DateTime? @map("reconciled_at") @db.Timestamptz(6)

  @@map("settlements")
}

/// ────────────────────── Bloc 7 — realtime + notifications (docs/27) ──────────
/// Persisted in-app notification (docs/27 §15). `type` reuses a `DomainEventType`
/// name rather than a second vocabulary. `dedupKey` is the outbox row id that
/// produced this row — the unique constraint with `userId` is what makes
/// at-least-once delivery produce exactly one notification per recipient.
model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  type               String
  titleKey           String    @map("title_key")
  bodyKey            String    @map("body_key")
  data               Json      @default("{}")
  referenceAggregate String?   @map("reference_aggregate")
  referenceId        String?   @map("reference_id") @db.Uuid
  dedupKey           String    @map("dedup_key")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt             DateTime? @map("read_at") @db.Timestamptz(6)

  @@unique([userId, dedupKey])
  @@map("notifications")
}

/// A registered push device (docs/27 §16). `pushToken` is sensitive — never
/// logged. Unique on its own: a token identifies one installation, and a
/// reinstall/account-switch legitimately re-points `userId` rather than
/// erroring (see `NotificationsService.registerDevice`'s upsert).
model NotificationDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  platform   String
  pushToken  String    @map("push_token")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@unique([pushToken])
  @@map("notification_devices")
}

/// FEAT-014: a courier's earnings paid to their Airtel Money (payments).
model CourierPayout {
  id             String    @id @default(uuid()) @db.Uuid
  courierId      String    @map("courier_id") @db.Uuid
  kind           String
  status         String    @default("requested")
  feePayer       String    @map("fee_payer")
  currency       String    @db.Char(3)
  requestedMinor BigInt    @map("requested_minor")
  paidMinor      BigInt?   @map("paid_minor")
  receivedMinor  BigInt?   @map("received_minor")
  airtelFeeMinor BigInt?   @map("airtel_fee_minor")
  periodStart    DateTime? @map("period_start") @db.Timestamptz(6)
  transactionRef String?   @map("transaction_ref")
  sentBy         String?   @map("sent_by") @db.Uuid
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)

  @@map("courier_payouts")
}

/// FEAT-016: a merchant phone forwarding the operator's SMS (payments).
model SmsGatewayDevice {
  id               String    @id @default(uuid()) @db.Uuid
  providerCode     String    @map("provider_code")
  label            String
  secretEnc        String    @map("secret_enc")
  createdBy        String    @map("created_by") @db.Uuid
  active           Boolean   @default(true)
  lastSeq          BigInt    @default(0) @map("last_seq")
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastBalanceMinor BigInt?   @map("last_balance_minor")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sms_gateway_devices")
}

/// FEAT-016: every SMS a gateway forwarded, and what became of it.
model MobileMoneySms {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  seq        BigInt
  sender     String
  body       String
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)
  outcome    String
  template   String?
  receiptId  String?  @map("receipt_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([deviceId, seq], map: "mobile_money_sms_seq_uk")
  @@map("mobile_money_sms")
}
