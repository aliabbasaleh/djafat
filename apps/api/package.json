{
  "name": "@djafat/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run --config test/vitest.int.config.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@djafat/config": "workspace:*",
    "@djafat/core": "workspace:*",
    "@djafat/types": "workspace:*",
    "@djafat/validation": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.11",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-fastify": "11.2.10",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/websockets": "11.2.10",
    "@prisma/client": "6.2.1",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.34.5",
    "fastify": "5.12.8",
    "ioredis": "5.4.2",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.2.1",
    "pino": "9.6.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@djafat/eslint-config": "workspace:*",
    "@djafat/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.10.18",
    "@types/node": "22.10.5",
    "@types/nodemailer": "7.0.4",
    "@types/smtp-server": "3.5.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "pino-pretty": "13.0.0",
    "prisma": "6.2.1",
    "rimraf": "6.0.1",
    "smtp-server": "3.20.2",
    "socket.io-client": "4.8.3",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "unplugin-swc": "1.6.0",
    "vitest": "2.1.8"
  }
}
