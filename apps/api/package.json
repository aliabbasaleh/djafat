{
  "name": "@djafat/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run --config test/vitest.int.config.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@djafat/config": "workspace:*",
    "@djafat/core": "workspace:*",
    "@djafat/types": "workspace:*",
    "@djafat/validation": "workspace:*",
    "@fastify/cors": "9.0.1",
    "@fastify/static": "7.0.4",
    "@fastify/helmet": "11.1.1",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/platform-fastify": "10.4.15",
    "@nestjs/platform-socket.io": "10.4.15",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/websockets": "10.4.15",
    "@prisma/client": "6.2.1",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.34.5",
    "fastify": "4.29.0",
    "ioredis": "5.4.2",
    "nestjs-pino": "4.1.0",
    "pino": "9.6.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@djafat/eslint-config": "workspace:*",
    "@djafat/tsconfig": "workspace:*",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "pino-pretty": "13.0.0",
    "prisma": "6.2.1",
    "rimraf": "6.0.1",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
