{
  "name": "@djafat/worker",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:int": "vitest run --config test/vitest.int.config.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@djafat/config": "workspace:*",
    "@djafat/core": "workspace:*",
    "@djafat/types": "workspace:*",
    "bullmq": "5.34.5",
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "@djafat/eslint-config": "workspace:*",
    "@djafat/tsconfig": "workspace:*",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "pino-pretty": "13.0.0",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
