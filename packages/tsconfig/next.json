{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@djafat/tsconfig/next",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": [],
    "allowJs": true,
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
