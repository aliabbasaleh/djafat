{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@djafat/tsconfig/react-native",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],
    "allowJs": true,
    "noEmit": true,
    "composite": false,
    "resolveJsonModule": true
  }
}
