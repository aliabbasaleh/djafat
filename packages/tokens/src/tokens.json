{
  "$comment": "DJAFAT design tokens (placeholder values — finalised with the designer at Bloc 3). See docs/10.",
  "color": {
    "brand": {
      "primary": "#E8531B",
      "primaryStrong": "#C43D0C",
      "onPrimary": "#FFFFFF"
    },
    "accent": { "secondary": "#0E7C66" },
    "bg": { "canvas": "#FBF7F2", "surface": "#FFFFFF", "surfaceAlt": "#F3EDE4" },
    "text": { "primary": "#1B1712", "secondary": "#5B534B", "muted": "#8A8078" },
    "border": { "default": "#E4DBCF" },
    "state": {
      "success": "#1E8E3E",
      "warning": "#B26B00",
      "danger": "#C62828",
      "info": "#1565C0"
    },
    "overlay": { "scrim": "rgba(20,15,10,0.55)" }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "14": 56
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "type": {
    "family": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "size": {
      "display": 28,
      "h1": 22,
      "h2": 18,
      "body": 15,
      "small": 13,
      "caption": 12
    }
  },
  "breakpoint": { "xs": 0, "sm": 360, "md": 600, "lg": 905, "xl": 1240, "2xl": 1600 },
  "z": {
    "base": 0,
    "sticky": 100,
    "header": 200,
    "dropdown": 300,
    "sheet": 400,
    "modal": 500,
    "toast": 600
  },
  "touchTarget": { "min": 44, "primary": 48 }
}
