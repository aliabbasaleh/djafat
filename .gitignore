*.keystore
*.mobileprovision

# Prisma
apps/api/prisma/*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
tmp/
.cache/

# Claude Code: local session state stays ignored; the SHARED project config
