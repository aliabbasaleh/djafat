# ============================================================================
# DJAFAT — Example environment file.
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Production secrets are injected from the Secret Manager (condition H3), not files.
# `@djafat/config` validates these at boot — the app refuses to start if a
# required variable is missing or malformed.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
LOG_LEVEL=debug                      # trace | debug | info | warn | error
APP_TIMEZONE=UTC                     # server clock is ALWAYS UTC (see docs/06 §6.1)

# --- API (apps/api) --------------------------------------------------------- -
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# --- Database (PostgreSQL 16 + PostGIS) ------------------------------------- -
# Local dev goes through PgBouncer (transaction pooling) — see infra/docker-compose.yml.
# `pgbouncer=true` is REQUIRED: PgBouncer's transaction pooling can hand a
# client's next statement to a different backend connection, so Prisma's
# server-side prepared statements randomly fail with "prepared statement
# \"sNN\" does not exist" (Postgres 26000) under any concurrent load — this
# flag makes Prisma use the simple query protocol instead (Prisma's own
# documented fix for PgBouncer transaction mode).
DATABASE_URL="postgresql://djafat:djafat_local_dev@localhost:6432/djafat?schema=public&pgbouncer=true"
# Direct (non-pooled) connection — required by Prisma Migrate / introspection
DIRECT_DATABASE_URL=postgresql://djafat:djafat_local_dev@localhost:5432/djafat?schema=public
# Restricted role used to grant/deny writes on ledger_* tables (see docs/08 §8.9)
LEDGER_DB_ROLE=djafat_ledger

# --- Redis (cache / locks / rate-limit / BullMQ transport — NOT source of truth) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible — behind ObjectStoragePort, no vendor SDK in code) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=eu-west-par
OBJECT_STORAGE_BUCKET=djafat-dev
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- Auth (Bloc 1 — docs/19). HS256: only apps/api itself ever verifies its
# own access tokens (monolith) — no asymmetric key pair needed. Refresh
# tokens are opaque random strings, hashed before being persisted (never a
# JWT), so REFRESH_TOKEN_HASH_SECRET is a distinct pepper from JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=REPLACE_ME_32_BYTES_MIN_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=djafat-api
JWT_AUDIENCE=djafat-clients
REFRESH_TOKEN_HASH_SECRET=REPLACE_ME_32_BYTES_MIN_RANDOM_SECRET
# AES-256-GCM key encrypting TOTP secrets at rest — 32 raw bytes, base64.
MFA_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_RAW_BYTES
STEP_UP_WINDOW_SECONDS=600
# AES-256-GCM key encrypting the delivery proof code at rest, so the owning
# customer can read their own code while it never sits in plaintext in
# `delivery_proofs` (docs/36 pilot fix). A key of its OWN — never reuse
# MFA_ENCRYPTION_KEY. 32 raw bytes, base64: `openssl rand -base64 32`.
DELIVERY_CODE_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_RAW_BYTES

# --- OTP delivery (OtpDeliveryPort — impl `sms` via mock in dev) ----------- -
OTP_CHANNELS=sms
SMS_PROVIDER=mock                    # mock (dev/CI) | http (real gateway — REQUIRED in production, FEAT-006)
SMS_MOCK_URL=http://localhost:4020
# Real gateway (aggregator, operator API, Kannel, Android SIM gateway):
# POST SMS_HTTP_URL {"to","from","body"} + Authorization: Bearer SMS_HTTP_API_KEY
# Local end-to-end test against infra/mock-sms: SMS_PROVIDER=http SMS_HTTP_URL=http://localhost:4020/send
# (left commented: an empty SMS_HTTP_URL is an invalid URL and would stop the API from booting)
# SMS_HTTP_URL=https://your-gateway.example.com/send
# SMS_HTTP_API_KEY=REPLACE_ME_GATEWAY_KEY
SMS_SENDER_ID=DJAFAT
# HMAC pepper for hashing OTP codes at rest — distinct from the auth secrets above.
OTP_HASH_SECRET=REPLACE_ME_32_BYTES_MIN_RANDOM_SECRET

# --- Payments (PaymentProvider registry — data-driven) -------------------- -
# Only `cash` and `mock` are enabled in dev. Real providers (airtel_money,
# moov_money, card_*) stay INACTIVE until access is verified (decision A1 / H1).
PAYMENT_MOCK_URL=http://localhost:4010
PAYMENT_WEBHOOK_BASE_URL=http://localhost:3001/v1/payments/webhook

# --- Observability -------------------------------------------------------- --
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=djafat-api

# --- Frontends ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
NEXT_PUBLIC_DEFAULT_COUNTRY=TD
NEXT_PUBLIC_DEFAULT_CITY=ndjamena
# Expo (apps/mobile)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/v1
